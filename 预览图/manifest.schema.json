{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yujianwudi/ai-image-prompts/blob/main/预览图/manifest.schema.json",
  "title": "AI Image Prompt Preview Manifest",
  "description": "Schema for public-safe README preview images used by this repository.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "description",
    "images"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "manifest.schema.json"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/preview_image"
      }
    }
  },
  "$defs": {
    "preview_image": {
      "type": "object",
      "required": [
        "file",
        "width",
        "height",
        "aspect_ratio",
        "orientation",
        "character",
        "scene",
        "prompt_pack",
        "caption",
        "public_safe",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.(jpg|jpeg|png|webp)$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square"
          ]
        },
        "character": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scene": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prompt_pack": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "public_safe": {
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
